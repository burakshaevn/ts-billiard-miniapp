{
  "name": "billiard-club",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "concurrently -k \"tsx watch server/index.ts\" \"vite --host 0.0.0.0\"",
    "build": "tsc -b && vite build",
    "start": "tsx server/index.ts --production",
    "test": "tsx --test shared/*.test.ts tests/*.test.ts",
    "test:e2e": "playwright test",
    "format": "prettier --write src shared server tests *.ts *.json *.html README.md"
  },
  "dependencies": {
    "@vitejs/plugin-react": "^4.3.4",
    "express": "^4.21.2",
    "lucide-react": "^0.468.0",
    "react": "^19.0.0",
    "react-dom": "^19.0.0",
    "three": "^0.172.0",
    "ws": "^8.18.0"
  },
  "devDependencies": {
    "@playwright/test": "^1.64.1",
    "@types/express": "^4.17.21",
    "@types/node": "^22.10.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "@types/three": "^0.172.0",
    "@types/ws": "^8.5.13",
    "concurrently": "^9.1.0",
    "prettier": "^3.9.10",
    "tsx": "^4.19.2",
    "typescript": "~5.7.2",
    "vite": "^6.0.5"
  }
}
