# Address of the authoritative game server (online play).
# GitHub Pages serves static files only and cannot answer a WebSocket upgrade,
# so the server has to run somewhere else, over https/wss.
# Empty value = practice table only.
VITE_GAME_SERVER=wss://your-server.example.com

# Direct link to the Mini App, used for "play with a friend" invitations.
VITE_BOT_APP_URL=https://t.me/your_bot/your_app
